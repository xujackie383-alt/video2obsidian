# ============================================================
# douyin2obsidian 配置示例
# 使用方法：复制本文件为 .env，然后按实际情况修改
# Windows:  copy .env.example .env
# macOS/Linux:  cp .env.example .env
# ============================================================

# ---------- DeepSeek ----------
# 在 https://platform.deepseek.com/api_keys 创建 API Key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 单次请求超时时间（秒）
DEEPSEEK_TIMEOUT=180

# ---------- Obsidian ----------
# Obsidian 知识库的绝对路径（Windows 可写 D:/Obsidian/MyVault）
# 笔记会直接生成在该目录下，不再创建额外子目录
OBSIDIAN_VAULT_PATH=D:/Obsidian/MyVault

# ---------- faster-whisper ----------
# tiny / base / small / medium / large-v3，中文建议 medium 及以上
WHISPER_MODEL=base
# auto / cpu / cuda，auto 会自动检测 GPU
WHISPER_DEVICE=auto
# auto / int8 / int8_float16 / float16 / float32 等，auto 时 GPU 用 float16、CPU 用 int8
WHISPER_COMPUTE_TYPE=auto
# zh 表示中文；auto 表示自动检测语言
WHISPER_LANGUAGE=zh
# 可选：模型缓存目录，留空时使用 HuggingFace 默认缓存
# WHISPER_DOWNLOAD_ROOT=D:/models/faster-whisper

# ---------- 网络与 yt-dlp ----------
# 可选：代理地址
# YTDLP_PROXY=http://127.0.0.1:7890
# 可选：抖音需要登录态时，填写导出的 cookies.txt 路径
# YTDLP_COOKIES_FILE=D:/cookies/douyin.txt

# ---------- 其他 ----------
# 临时音频目录，相对路径以项目根目录为基准
TEMP_DIR=temp
# 转录文本超过该字符数时，会先分段提炼再整体整合
SUMMARY_MAX_INPUT_CHARS=12000
